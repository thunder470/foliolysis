# ==============================================================================
# Global Git Ignore for foliolysis
# ==============================================================================

# Critical: Environment Variables & Secrets
.env
.env.*
*.env
analytics/.env
backend/.env
frontend/.env

# Python Artifacts & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
analytics/venv/
analytics/.venv/
venv/
.venv/
env/
.pytest_cache/

# Node & Frontend Build Artifacts
node_modules/
backend/node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker Data Volumes
mongo-data/

# Test & Debug Artifacts
screenshots/
*.log
backend/*.log
frontend/*.log
analytics/*.log

# OS & Editor Artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

